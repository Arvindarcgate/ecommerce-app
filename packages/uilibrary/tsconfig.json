{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",

    "module": "ESNext",
    "moduleResolution": "NodeNext",

    "composite": true,
    "outDir": "../../dist/out-tsc",
    "rootDir": "./src",

    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
